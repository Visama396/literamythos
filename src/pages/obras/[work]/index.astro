---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CollectionCard from "@/components/CollectionCard.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "cn";
import {
  getCollectionsForWork,
  getTextsForCollection,
  getWorkLanguages,
  languageName,
  works,
} from "@/lib/content";
import type { Work } from "@/content/schemas";

export function getStaticPaths() {
  return works.map((work) => ({ params: { work: work.slug }, props: { work } }));
}

interface Props {
  work: Work;
}

const { work } = Astro.props;
const collections = getCollectionsForWork(work.id).map((collection) => {
  const texts = getTextsForCollection(collection.id);
  return {
    collection,
    textCount: texts.length,
    languages: [...new Set(texts.flatMap((item) => item.versions.map((version) => version.language)))].sort(),
  };
});
const languages = getWorkLanguages(work.id);
const textCount = collections.reduce((total, entry) => total + entry.textCount, 0);
---
<BaseLayout title={work.title} description={work.description}>
  <nav aria-label="Miga de pan" class="mb-8 flex flex-wrap items-center gap-2 text-sm text-warm-muted">
    <a href="/" class="link-quiet">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href="/obras" class="link-quiet">Obras</a>
    <span aria-hidden="true">/</span>
    <span class="text-parchment">{work.title}</span>
  </nav>

  <section class="grid gap-8 lg:grid-cols-[auto_1fr] lg:items-start">
    <div class="flex size-28 items-center justify-center rounded-full border border-gold/40 bg-gold/5 font-display text-4xl text-gold">
      {work.title.slice(0, 1)}
    </div>
    <div class="space-y-5">
      <div class="space-y-3">
        <p class="eyebrow">Obra</p>
        <h1 class="font-display text-4xl text-parchment sm:text-5xl">{work.title}</h1>
        <p class="text-sm uppercase tracking-[0.22em] text-warm-muted">
          {work.creator}
          {work.creatorTransliteration && (
            <span class="ml-2 normal-case tracking-[0.08em] text-warm-muted/80">{work.creatorTransliteration}</span>
          )}
        </p>
      </div>
      <p class="max-w-3xl text-lg leading-relaxed text-warm-muted">{work.description}</p>
      <div class="flex flex-wrap gap-2">
        {work.tags.map((tag) => (
          <span class="rounded-full border border-bronze/60 px-2.5 py-1 text-xs text-warm-muted">{tag}</span>
        ))}
      </div>
      <div class="flex flex-wrap gap-2">
        {languages.map((code) => (
          <span class="rounded-full border border-gold/40 bg-gold/5 px-2.5 py-1 text-[0.68rem] uppercase tracking-[0.18em] text-gold">{languageName(code)}</span>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-4 border-t border-bronze/50 pt-5 text-sm text-warm-muted">
        <span>{collections.length} colección{collections.length === 1 ? "" : "es"}</span>
        <span>{textCount} texto{textCount === 1 ? "" : "s"}</span>
        <span>{languages.length} idioma{languages.length === 1 ? "" : "s"}</span>
        <a href={`/buscar`} class={cn(buttonVariants({ variant: "outline", size: "sm" }), "ml-auto border-gold/50 text-gold hover:bg-gold/10")}>
          Buscar en esta obra
        </a>
      </div>
    </div>
  </section>

  <div class="my-10 hairline"></div>

  <section class="space-y-6">
    <div class="space-y-2">
      <p class="eyebrow">Contenido</p>
      <h2 class="font-display text-3xl text-parchment">Colecciones</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {collections.map(({ collection, textCount, languages }) => (
        <CollectionCard work={work} collection={collection} textCount={textCount} languages={languages} />
      ))}
    </div>
  </section>
</BaseLayout>
