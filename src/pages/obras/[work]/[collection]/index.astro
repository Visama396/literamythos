---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CollectionBrowser, { type CollectionItem } from "@/components/CollectionBrowser";
import { excerpt, getTextsForCollection, languageName, works, getCollectionsForWork } from "@/lib/content";
import type { Collection, Work } from "@/content/schemas";

export function getStaticPaths() {
  return works.flatMap((work) =>
    getCollectionsForWork(work.id).map((collection) => ({
      params: { work: work.slug, collection: collection.slug },
      props: { work, collection },
    })),
  );
}

interface Props {
  work: Work;
  collection: Collection;
}

const { work, collection } = Astro.props;
const entries = getTextsForCollection(collection.id);
const languages = [...new Set(entries.flatMap((item) => item.versions.map((version) => version.language)))].sort();

const items: CollectionItem[] = entries.map((item) => {
  const original = item.versions.find((version) => version.kind === "original") ?? item.versions[0];
  return {
    id: item.text.id,
    title: item.text.title,
    subtitle: item.text.subtitle,
    character: item.text.character,
    characterTransliteration: item.text.characterTransliteration,
    volume: item.text.volume,
    tags: item.text.tags,
    languages: [...new Set(item.versions.map((version) => version.language))],
    excerpt: excerpt(original.content, 160),
    href: `/obras/${work.slug}/${collection.slug}/${item.text.slug}`,
  };
});
---
<BaseLayout title={`${collection.title} · ${work.title}`} description={collection.description}>
  <nav aria-label="Miga de pan" class="mb-8 flex flex-wrap items-center gap-2 text-sm text-warm-muted">
    <a href="/" class="link-quiet">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href="/obras" class="link-quiet">Obras</a>
    <span aria-hidden="true">/</span>
    <a href={`/obras/${work.slug}`} class="link-quiet">{work.title}</a>
    <span aria-hidden="true">/</span>
    <span class="text-parchment">{collection.title}</span>
  </nav>

  <header class="max-w-3xl space-y-4">
    <p class="eyebrow">{work.title} · Colección</p>
    <h1 class="font-display text-4xl text-parchment sm:text-5xl">{collection.title}</h1>
    <p class="text-lg leading-relaxed text-warm-muted">{collection.description}</p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-warm-muted">
      <span>{entries.length} texto{entries.length === 1 ? "" : "s"}</span>
      <span class="flex flex-wrap gap-1.5">
        {languages.map((code) => (
          <span class="rounded bg-surface-raised px-1.5 py-0.5 text-xs">{languageName(code)}</span>
        ))}
      </span>
    </div>
  </header>

  <div class="my-8 hairline"></div>

  <CollectionBrowser items={items} client:load />
</BaseLayout>
