---
import ReadingLayout from "@/layouts/ReadingLayout.astro";
import TextVersion from "@/components/TextVersion.astro";
import TranslationComparator, { type ComparatorVersion } from "@/components/TranslationComparator";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "cn";
import { kindLabel, languageName, texts } from "@/lib/content";

export function getStaticPaths() {
  return texts.map((item) => ({
    params: {
      work: item.work.slug,
      collection: item.collection.slug,
      text: item.text.slug,
    },
    props: { item },
  }));
}

const { item } = Astro.props;
const { work, collection, text, versions } = item;

const originalVersions = versions.filter((version) => version.kind === "original");
const translations = versions.filter((version) => version.kind !== "original");
const sortedOriginals = originalVersions.length > 0 ? originalVersions : versions.slice(0, 1);

const comparatorVersions: ComparatorVersion[] = versions.map((version) => ({
  id: version.id,
  language: version.language,
  label: version.label,
  content: version.content,
  kind: version.kind,
  translator: version.translator,
  source: version.source,
  transliteration: version.transliteration,
  notes: version.notes,
}));
---
<ReadingLayout title={text.title} description={text.subtitle ?? `${text.title}, de ${work.title}.`}>
  <nav aria-label="Miga de pan" class="mb-8 flex flex-wrap items-center gap-2 text-sm text-warm-muted">
    <a href="/" class="link-quiet">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href="/obras" class="link-quiet">Obras</a>
    <span aria-hidden="true">/</span>
    <a href={`/obras/${work.slug}`} class="link-quiet">{work.title}</a>
    <span aria-hidden="true">/</span>
    <a href={`/obras/${work.slug}/${collection.slug}`} class="link-quiet">{collection.title}</a>
    <span aria-hidden="true">/</span>
    <span class="text-parchment">{text.title}</span>
  </nav>

  <header class="space-y-4">
    <p class="eyebrow">{work.title} · {collection.title}</p>
    <h1 class="font-display text-4xl text-parchment sm:text-5xl">{text.title}</h1>
    {text.subtitle && <p class="text-xl text-warm-muted">{text.subtitle}</p>}

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-warm-muted">
      {text.character && (
        <span>
          {text.character}
          {text.characterTransliteration && (
            <span class="ml-1.5 text-warm-muted/70">{text.characterTransliteration}</span>
          )}
        </span>
      )}
      {typeof text.volume === "number" && <span>Tomo {text.volume}</span>}
      {text.creator && (
        <span>
          {text.creator}
          {text.creatorTransliteration && (
            <span class="ml-1.5 text-warm-muted/70">{text.creatorTransliteration}</span>
          )}
        </span>
      )}
      {text.publicationDate && <span>{text.publicationDate}</span>}
    </div>

    <div class="flex flex-wrap gap-2">
      {text.tags.map((tag) => (
        <span class="rounded-full border border-bronze/60 px-2.5 py-1 text-xs text-warm-muted">{tag}</span>
      ))}
    </div>
  </header>

  <div class="my-8 hairline"></div>

  <div class="space-y-8">
    <section class="space-y-4" aria-labelledby="original-title">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="original-title" class="font-display text-2xl text-parchment">Original</h2>
        <span class="text-xs uppercase tracking-[0.18em] text-warm-muted">Texto de partida</span>
      </div>
      {sortedOriginals.map((version) => (
        <TextVersion version={version} />
      ))}
    </section>

    <section class="space-y-4" aria-labelledby="translations-title">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="translations-title" class="font-display text-2xl text-parchment">Traducciones</h2>
        <span class="text-xs uppercase tracking-[0.18em] text-warm-muted">{translations.length} versión{translations.length === 1 ? "" : "es"} disponible{translations.length === 1 ? "" : "s"}</span>
      </div>
      {translations.length > 0 ? (
        <div class="space-y-4">
          {translations.map((version) => (
            <TextVersion version={version} />
          ))}
        </div>
      ) : (
        <p class="rounded-lg border border-dashed border-bronze/70 bg-surface/40 p-6 text-sm text-warm-muted">
          Todavía no hay traducciones disponibles para este texto.
        </p>
      )}
    </section>

    {text.notes && (
      <section class="space-y-3" aria-labelledby="notes-title">
        <h2 id="notes-title" class="font-display text-2xl text-parchment">Notas editoriales</h2>
        <div class="rounded-lg border border-bronze/70 bg-surface/50 p-6 text-sm leading-relaxed whitespace-pre-line text-warm-muted">
          {text.notes}
        </div>
      </section>
    )}

    <section id="comparador" class="space-y-4 scroll-mt-24" aria-labelledby="comparator-title">
      <h2 id="comparator-title" class="font-display text-2xl text-parchment">Comparador</h2>
      <TranslationComparator versions={comparatorVersions} client:load />
    </section>
  </div>

  <div slot="aside" class="space-y-6">
    <div class="rounded-lg border border-bronze/70 bg-surface/60 p-5">
      <p class="eyebrow">Metadatos</p>
      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="text-xs uppercase tracking-[0.18em] text-warm-muted">Obra</dt>
          <dd class="mt-0.5">
            <a href={`/obras/${work.slug}`} class="text-parchment hover:text-gold">{work.title}</a>
          </dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.18em] text-warm-muted">Colección</dt>
          <dd class="mt-0.5">
            <a href={`/obras/${work.slug}/${collection.slug}`} class="text-parchment hover:text-gold">{collection.title}</a>
          </dd>
        </div>
        {text.character && (
          <div>
            <dt class="text-xs uppercase tracking-[0.18em] text-warm-muted">Personaje</dt>
            <dd class="mt-0.5 text-parchment">
              {text.character}
              {text.characterTransliteration && (
                <span class="ml-1.5 text-warm-muted/70">{text.characterTransliteration}</span>
              )}
            </dd>
          </div>
        )}
        {text.creator && (
          <div>
            <dt class="text-xs uppercase tracking-[0.18em] text-warm-muted">Autoría</dt>
            <dd class="mt-0.5 text-parchment">
              {text.creator}
              {text.creatorTransliteration && (
                <span class="ml-1.5 text-warm-muted/70">{text.creatorTransliteration}</span>
              )}
            </dd>
          </div>
        )}
        {typeof text.volume === "number" && (
          <div>
            <dt class="text-xs uppercase tracking-[0.18em] text-warm-muted">Tomo</dt>
            <dd class="mt-0.5 text-parchment">{text.volume}</dd>
          </div>
        )}
        {text.source && (
          <div>
            <dt class="text-xs uppercase tracking-[0.18em] text-warm-muted">Fuente</dt>
            <dd class="mt-0.5 text-parchment/80">{text.source}</dd>
          </div>
        )}
      </dl>
    </div>

    <div class="rounded-lg border border-bronze/70 bg-surface/60 p-5">
      <p class="eyebrow">Versiones</p>
      <ul class="mt-3 space-y-2 text-sm">
        {versions.map((version) => (
          <li class="flex items-center justify-between gap-2">
            <span class="text-warm-muted">{languageName(version.language)}</span>
            <span class="text-xs text-warm-muted/80">{kindLabel(version.kind)}</span>
          </li>
        ))}
      </ul>
      <a href="#comparador" class={cn(buttonVariants({ variant: "outline", size: "sm" }), "mt-4 w-full border-gold/50 text-gold hover:bg-gold/10")}>
        Ir al comparador
      </a>
    </div>

    <div class="rounded-lg border border-bronze/50 bg-surface/40 p-5 text-xs leading-relaxed text-warm-muted">
      <p class="eyebrow mb-2 text-[0.62rem]">Aviso</p>
      <p>
        Los textos se ofrecen con fines de lectura y comparación. Revisa la procedencia de cada versión y los permisos aplicables antes de reutilizar el contenido.
      </p>
    </div>
  </div>
</ReadingLayout>
