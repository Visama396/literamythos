---
import type { Work } from "@/content/schemas";
import { languageName } from "@/lib/content";

interface Props {
  work: Work;
  collectionCount: number;
  textCount: number;
  languages: string[];
}

const { work, collectionCount, textCount, languages } = Astro.props;
---
<a href={`/obras/${work.slug}`} class="group block h-full">
  <article class="card-hover flex h-full flex-col rounded-lg border border-bronze/70 bg-surface/70 p-6">
    <div class="mb-5 flex items-start justify-between gap-4">
      <div class="flex size-14 items-center justify-center rounded-full border border-gold/40 bg-gold/5 font-display text-xl text-gold">
        {work.title.slice(0, 1)}
      </div>
      <span class="rounded-full border border-gold/40 px-2.5 py-1 text-[0.65rem] uppercase tracking-[0.2em] text-gold">Obra</span>
    </div>

    <h2 class="font-display text-2xl text-parchment transition-colors group-hover:text-gold">{work.title}</h2>
    <p class="mt-1 text-xs uppercase tracking-[0.22em] text-warm-muted">
      {work.creator}
      {work.creatorTransliteration && (
        <span class="ml-2 normal-case tracking-[0.08em] text-warm-muted/80">{work.creatorTransliteration}</span>
      )}
    </p>
    <p class="mt-4 flex-1 text-sm leading-relaxed text-warm-muted">{work.description}</p>

    <div class="mt-5 flex flex-wrap gap-2">
      {work.tags.map((tag) => (
        <span class="rounded-full border border-bronze/60 px-2.5 py-1 text-xs text-warm-muted">{tag}</span>
      ))}
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-bronze/50 pt-4 text-xs text-warm-muted">
      <span>{collectionCount} colección{collectionCount === 1 ? "" : "es"}</span>
      <span>{textCount} texto{textCount === 1 ? "" : "s"}</span>
      <span class="flex flex-wrap gap-1.5">
        {languages.map((code) => (
          <span class="rounded bg-surface-raised px-1.5 py-0.5 text-[0.68rem]">{languageName(code)}</span>
        ))}
      </span>
    </div>
  </article>
</a>
